---
import type { BreadcrumbItem } from "../../types/tool";
import { withBasePath } from "../../utils/seo";

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-slate-600">
  <ol class="flex flex-wrap items-center gap-2">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-2">
          {item.href ? (
            <a class="font-medium text-slate-700 hover:text-brand-teal" href={withBasePath(item.href)}>
              {item.label}
            </a>
          ) : (
            <span class="text-slate-500">{item.label}</span>
          )}
          {index < items.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
