---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-3xl">
  {eyebrow && <p class="mb-3 text-sm font-semibold uppercase text-brand-teal">{eyebrow}</p>}
  <h2 class="text-2xl font-semibold text-ink md:text-3xl">{title}</h2>
  {description && <p class="mt-3 text-base leading-7 text-slate-600">{description}</p>}
</div>
