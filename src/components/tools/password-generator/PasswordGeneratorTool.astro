<div class="space-y-5" data-password-generator>
  <div>
    <label for="password-output" class="mb-2 block text-sm font-semibold text-ink">Generated password</label>
    <input id="password-output" class="h-12 w-full rounded-md border border-slate-300 bg-slate-50 px-4 font-mono text-sm text-ink" readonly data-password-output />
  </div>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <label class="text-sm font-semibold text-ink">
      Length
      <input class="mt-2 h-11 w-full rounded-md border border-slate-300 px-3" type="number" min="8" max="128" value="20" data-password-length />
    </label>
    <label class="flex items-end gap-2 text-sm font-semibold text-ink"><input class="mb-3 h-4 w-4 accent-brand-teal" type="checkbox" checked data-password-lower /> Lowercase</label>
    <label class="flex items-end gap-2 text-sm font-semibold text-ink"><input class="mb-3 h-4 w-4 accent-brand-teal" type="checkbox" checked data-password-upper /> Uppercase</label>
    <label class="flex items-end gap-2 text-sm font-semibold text-ink"><input class="mb-3 h-4 w-4 accent-brand-teal" type="checkbox" checked data-password-numbers /> Numbers</label>
    <label class="flex items-end gap-2 text-sm font-semibold text-ink"><input class="mb-3 h-4 w-4 accent-brand-teal" type="checkbox" checked data-password-symbols /> Symbols</label>
  </div>
  <div class="flex flex-wrap gap-3">
    <button type="button" class="rounded-md bg-brand-teal px-4 py-2 text-sm font-semibold text-white hover:bg-teal-800" data-password-generate>Generate</button>
    <button type="button" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-teal-200 hover:text-brand-teal" data-password-copy>Copy</button>
  </div>
  <p class="text-sm font-medium" data-password-status></p>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-password-generator]");
  const output = root?.querySelector<HTMLInputElement>("[data-password-output]");
  const lengthInput = root?.querySelector<HTMLInputElement>("[data-password-length]");
  const status = root?.querySelector<HTMLElement>("[data-password-status]");
  const sets = {
    lower: "abcdefghijklmnopqrstuvwxyz",
    upper: "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
    numbers: "0123456789",
    symbols: "!@#$%^&*()_+-=[]{};:,.<>?"
  };

  const randomIndex = (max: number): number => {
    const array = new Uint32Array(1);
    crypto.getRandomValues(array);
    return array[0] % max;
  };

  const shuffle = (chars: string[]): string[] => {
    for (let index = chars.length - 1; index > 0; index -= 1) {
      const target = randomIndex(index + 1);
      [chars[index], chars[target]] = [chars[target], chars[index]];
    }
    return chars;
  };

  const generate = (): void => {
    if (!root || !output || !lengthInput || !status) return;

    const selected = [
      root.querySelector<HTMLInputElement>("[data-password-lower]")?.checked ? sets.lower : "",
      root.querySelector<HTMLInputElement>("[data-password-upper]")?.checked ? sets.upper : "",
      root.querySelector<HTMLInputElement>("[data-password-numbers]")?.checked ? sets.numbers : "",
      root.querySelector<HTMLInputElement>("[data-password-symbols]")?.checked ? sets.symbols : ""
    ].filter(Boolean);

    if (selected.length === 0) {
      status.className = "text-sm font-medium text-rose-700";
      status.textContent = "Select at least one character set.";
      output.value = "";
      return;
    }

    const length = Math.min(128, Math.max(8, Number(lengthInput.value) || 20));
    const allChars = selected.join("");
    const password = selected.map((set) => set[randomIndex(set.length)]);

    while (password.length < length) {
      password.push(allChars[randomIndex(allChars.length)]);
    }

    output.value = shuffle(password).join("");
    status.className = "text-sm font-medium text-emerald-700";
    status.textContent = "Password generated locally.";
  };

  root?.querySelector<HTMLButtonElement>("[data-password-generate]")?.addEventListener("click", generate);
  root?.querySelector<HTMLButtonElement>("[data-password-copy]")?.addEventListener("click", async () => {
    if (!output || !status) return;
    await navigator.clipboard.writeText(output.value);
    status.className = "text-sm font-medium text-emerald-700";
    status.textContent = "Copied.";
  });

  generate();
</script>
