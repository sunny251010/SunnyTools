---
import { defaultLocale, type Locale } from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = getMessages(locale).toolUi;
---

<div class="space-y-5" data-sort-lines data-copied={copy.shared.copied} data-sorted={copy.sortLines.sorted}>
  <div class="grid gap-4 lg:grid-cols-2">
    <div>
      <label for="sort-lines-input" class="mb-2 block text-sm font-semibold text-ink">{copy.shared.input}</label>
      <textarea
        id="sort-lines-input"
        class="min-h-72 w-full rounded-md border border-slate-300 bg-slate-50 p-4 font-mono text-sm leading-7 text-ink shadow-inner focus:border-brand-teal focus:bg-white"
        data-sort-input></textarea>
    </div>
    <div>
      <label for="sort-lines-output" class="mb-2 block text-sm font-semibold text-ink">{copy.shared.output}</label>
      <textarea
        id="sort-lines-output"
        class="min-h-72 w-full rounded-md border border-slate-300 bg-white p-4 font-mono text-sm leading-7 text-ink shadow-inner"
        readonly
        data-sort-output></textarea>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <label class="text-sm font-semibold text-ink">
      {copy.sortLines.sortType}
      <select class="mt-2 h-11 w-full rounded-md border border-slate-300 bg-white px-3" data-sort-type>
        <option value="text">{copy.sortLines.text}</option>
        <option value="numeric">{copy.sortLines.numeric}</option>
      </select>
    </label>
    <label class="text-sm font-semibold text-ink">
      {copy.sortLines.direction}
      <select class="mt-2 h-11 w-full rounded-md border border-slate-300 bg-white px-3" data-sort-direction>
        <option value="asc">{copy.sortLines.ascending}</option>
        <option value="desc">{copy.sortLines.descending}</option>
      </select>
    </label>
    <label class="flex items-end gap-2 text-sm font-semibold text-ink">
      <input class="mb-3 h-4 w-4 accent-brand-teal" type="checkbox" checked data-sort-trim />
      {copy.sortLines.trimLines}
    </label>
    <label class="flex items-end gap-2 text-sm font-semibold text-ink">
      <input class="mb-3 h-4 w-4 accent-brand-teal" type="checkbox" data-sort-empty />
      {copy.sortLines.skipEmpty}
    </label>
    <label class="flex items-end gap-2 text-sm font-semibold text-ink">
      <input class="mb-3 h-4 w-4 accent-brand-teal" type="checkbox" data-sort-unique />
      {copy.sortLines.uniqueOnly}
    </label>
  </div>

  <div class="flex flex-wrap gap-3">
    <button type="button" class="rounded-md bg-brand-teal px-4 py-2 text-sm font-semibold text-white hover:bg-teal-800" data-sort-run>
      {copy.shared.convert}
    </button>
    <button type="button" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-teal-200 hover:text-brand-teal" data-sort-copy>
      {copy.shared.copy}
    </button>
    <button type="button" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-teal-200 hover:text-brand-teal" data-sort-clear>
      {copy.shared.clear}
    </button>
  </div>
  <p class="text-sm font-medium text-emerald-700" role="status" data-sort-status></p>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-sort-lines]");
  const input = root?.querySelector<HTMLTextAreaElement>("[data-sort-input]");
  const output = root?.querySelector<HTMLTextAreaElement>("[data-sort-output]");
  const typeInput = root?.querySelector<HTMLSelectElement>("[data-sort-type]");
  const directionInput = root?.querySelector<HTMLSelectElement>("[data-sort-direction]");
  const trimInput = root?.querySelector<HTMLInputElement>("[data-sort-trim]");
  const emptyInput = root?.querySelector<HTMLInputElement>("[data-sort-empty]");
  const uniqueInput = root?.querySelector<HTMLInputElement>("[data-sort-unique]");
  const status = root?.querySelector<HTMLElement>("[data-sort-status]");
  const copied = root?.dataset.copied ?? "Copied.";
  const sorted = root?.dataset.sorted ?? "Lines sorted.";

  const prepareLines = (value: string): string[] => {
    let lines = value.split(/\r?\n/).map((line) => (trimInput?.checked ? line.trim() : line));

    if (emptyInput?.checked) {
      lines = lines.filter((line) => line.length > 0);
    }

    if (uniqueInput?.checked) {
      lines = Array.from(new Set(lines));
    }

    return lines;
  };

  const compareNumbers = (left: string, right: string): number => {
    const leftNumber = Number(left);
    const rightNumber = Number(right);

    if (Number.isFinite(leftNumber) && Number.isFinite(rightNumber)) {
      return leftNumber - rightNumber;
    }

    return left.localeCompare(right, undefined, { numeric: true, sensitivity: "base" });
  };

  const sortLines = (): void => {
    if (!input || !output || !typeInput || !directionInput || !status) return;

    const direction = directionInput.value === "desc" ? -1 : 1;
    const sortedLines = prepareLines(input.value).sort((left, right) => {
      const result =
        typeInput.value === "numeric"
          ? compareNumbers(left, right)
          : left.localeCompare(right, undefined, { numeric: true, sensitivity: "base" });
      return result * direction;
    });

    output.value = sortedLines.join("\n");
    status.textContent = sorted;
  };

  const clear = (): void => {
    if (!input || !output || !status) return;
    input.value = "";
    output.value = "";
    status.textContent = "";
  };

  root?.querySelector<HTMLButtonElement>("[data-sort-run]")?.addEventListener("click", sortLines);
  root?.querySelector<HTMLButtonElement>("[data-sort-copy]")?.addEventListener("click", async () => {
    if (!output || !status) return;
    await navigator.clipboard.writeText(output.value);
    status.textContent = copied;
  });
  root?.querySelector<HTMLButtonElement>("[data-sort-clear]")?.addEventListener("click", clear);
  input?.addEventListener("input", sortLines);
  typeInput?.addEventListener("change", sortLines);
  directionInput?.addEventListener("change", sortLines);
  trimInput?.addEventListener("change", sortLines);
  emptyInput?.addEventListener("change", sortLines);
  uniqueInput?.addEventListener("change", sortLines);
</script>
