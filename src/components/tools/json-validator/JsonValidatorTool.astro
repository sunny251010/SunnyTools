---
import { defaultLocale, type Locale } from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = getMessages(locale).toolUi;
---

<div
  class="space-y-5"
  data-json-validator
  data-valid={copy.jsonValidator.valid}
  data-invalid={copy.jsonValidator.invalid}
  data-empty={copy.jsonValidator.empty}
  data-line={copy.jsonValidator.line}
  data-column={copy.jsonValidator.column}
>
  <div>
    <label for="json-validator-input" class="mb-2 block text-sm font-semibold text-ink">{copy.json.input}</label>
    <textarea
      id="json-validator-input"
      class="min-h-80 w-full rounded-md border border-slate-300 bg-slate-50 p-4 font-mono text-sm leading-6 text-ink shadow-inner focus:border-brand-teal focus:bg-white"
      placeholder='{"hello":"world"}'
      data-json-validator-input></textarea>
  </div>

  <div class="flex flex-wrap gap-3">
    <button type="button" class="rounded-md bg-brand-teal px-4 py-2 text-sm font-semibold text-white hover:bg-teal-800" data-json-validator-run>
      {copy.jsonValidator.validate}
    </button>
    <button type="button" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-teal-200 hover:text-brand-teal" data-json-validator-clear>
      {copy.shared.clear}
    </button>
  </div>

  <section class="grid gap-4 md:grid-cols-[minmax(0,1fr)_320px]">
    <div class="rounded-md border border-slate-200 bg-white p-4">
      <h2 class="text-base font-semibold text-ink">{copy.jsonValidator.status}</h2>
      <p class="mt-3 text-sm font-medium" role="status" data-json-validator-status></p>
      <p class="mt-2 font-mono text-sm leading-6 text-slate-700" data-json-validator-error></p>
    </div>
    <div class="rounded-md border border-slate-200 bg-slate-50 p-4">
      <h2 class="text-base font-semibold text-ink">{copy.jsonValidator.details}</h2>
      <dl class="mt-3 space-y-2 text-sm">
        <div class="flex justify-between gap-4">
          <dt class="text-slate-600">{copy.jsonValidator.rootType}</dt>
          <dd class="font-semibold text-ink" data-json-validator-type>-</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-slate-600">{copy.jsonValidator.itemCount}</dt>
          <dd class="font-semibold text-ink" data-json-validator-count>-</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-slate-600">{copy.jsonValidator.characterCount}</dt>
          <dd class="font-semibold text-ink" data-json-validator-chars>0</dd>
        </div>
      </dl>
    </div>
  </section>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-json-validator]");
  const input = root?.querySelector<HTMLTextAreaElement>("[data-json-validator-input]");
  const status = root?.querySelector<HTMLElement>("[data-json-validator-status]");
  const errorText = root?.querySelector<HTMLElement>("[data-json-validator-error]");
  const typeText = root?.querySelector<HTMLElement>("[data-json-validator-type]");
  const countText = root?.querySelector<HTMLElement>("[data-json-validator-count]");
  const charsText = root?.querySelector<HTMLElement>("[data-json-validator-chars]");
  const valid = root?.dataset.valid ?? "Valid JSON.";
  const invalid = root?.dataset.invalid ?? "Invalid JSON.";
  const empty = root?.dataset.empty ?? "Paste JSON to validate.";
  const lineLabel = root?.dataset.line ?? "Line";
  const columnLabel = root?.dataset.column ?? "Column";

  const getJsonType = (value: unknown): string => {
    if (Array.isArray(value)) return "array";
    if (value === null) return "null";
    return typeof value;
  };

  const getItemCount = (value: unknown): string => {
    if (Array.isArray(value)) return String(value.length);
    if (value && typeof value === "object") return String(Object.keys(value).length);
    return "-";
  };

  const getPositionHint = (message: string, source: string): string => {
    const position = message.match(/position\s+(\d+)/i)?.[1];
    if (!position) return "";

    const offset = Number(position);
    if (!Number.isFinite(offset)) return "";

    const before = source.slice(0, offset);
    const lines = before.split(/\r?\n/);
    const line = lines.length;
    const column = lines[lines.length - 1].length + 1;

    return ` ${lineLabel} ${line}, ${columnLabel} ${column}.`;
  };

  const validate = (): void => {
    if (!input || !status || !errorText || !typeText || !countText || !charsText) return;

    const value = input.value;
    charsText.textContent = String(value.length);

    if (value.trim().length === 0) {
      status.className = "mt-3 text-sm font-medium text-slate-600";
      status.textContent = empty;
      errorText.textContent = "";
      typeText.textContent = "-";
      countText.textContent = "-";
      return;
    }

    try {
      const parsed = JSON.parse(value);
      status.className = "mt-3 text-sm font-medium text-emerald-700";
      status.textContent = valid;
      errorText.textContent = "";
      typeText.textContent = getJsonType(parsed);
      countText.textContent = getItemCount(parsed);
    } catch (error) {
      const message = error instanceof Error ? error.message : invalid;
      status.className = "mt-3 text-sm font-medium text-rose-700";
      status.textContent = invalid;
      errorText.textContent = `${message}.${getPositionHint(message, value)}`;
      typeText.textContent = "-";
      countText.textContent = "-";
    }
  };

  const clear = (): void => {
    if (!input || !status || !errorText || !typeText || !countText || !charsText) return;
    input.value = "";
    status.textContent = "";
    errorText.textContent = "";
    typeText.textContent = "-";
    countText.textContent = "-";
    charsText.textContent = "0";
  };

  root?.querySelector<HTMLButtonElement>("[data-json-validator-run]")?.addEventListener("click", validate);
  root?.querySelector<HTMLButtonElement>("[data-json-validator-clear]")?.addEventListener("click", clear);
  input?.addEventListener("input", validate);
  validate();
</script>
