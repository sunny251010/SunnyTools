<div class="space-y-5" data-qr-generator>
  <div class="grid gap-4 lg:grid-cols-[1fr_320px]">
    <div>
      <label for="qr-input" class="mb-2 block text-sm font-semibold text-ink">Text or URL</label>
      <textarea
        id="qr-input"
        class="min-h-40 w-full rounded-md border border-slate-300 bg-slate-50 p-4 text-base leading-7 text-ink shadow-inner focus:border-brand-teal focus:bg-white"
        data-qr-input>https://example.com</textarea>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <label class="text-sm font-semibold text-ink">
          Size
          <input class="mt-2 w-full accent-brand-teal" type="range" min="160" max="520" step="20" value="280" data-qr-size />
        </label>
        <label class="text-sm font-semibold text-ink">
          Margin
          <input class="mt-2 w-full accent-brand-teal" type="range" min="0" max="6" value="2" data-qr-margin />
        </label>
      </div>
      <div class="mt-4 flex flex-wrap gap-3">
        <button type="button" class="rounded-md bg-brand-teal px-4 py-2 text-sm font-semibold text-white hover:bg-teal-800" data-qr-render>
          Generate
        </button>
        <a class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-teal-200 hover:text-brand-teal" href="#" download="qr-code.png" data-qr-download>
          Download PNG
        </a>
      </div>
      <p class="mt-3 text-sm font-medium text-rose-700" role="alert" data-qr-error></p>
    </div>
    <div class="grid place-items-center rounded-md border border-slate-200 bg-white p-5">
      <canvas class="max-w-full" width="280" height="280" data-qr-canvas></canvas>
    </div>
  </div>
</div>

<script>
  import QRCode from "qrcode";

  const root = document.querySelector<HTMLElement>("[data-qr-generator]");
  const input = root?.querySelector<HTMLTextAreaElement>("[data-qr-input]");
  const sizeInput = root?.querySelector<HTMLInputElement>("[data-qr-size]");
  const marginInput = root?.querySelector<HTMLInputElement>("[data-qr-margin]");
  const canvas = root?.querySelector<HTMLCanvasElement>("[data-qr-canvas]");
  const download = root?.querySelector<HTMLAnchorElement>("[data-qr-download]");
  const error = root?.querySelector<HTMLElement>("[data-qr-error]");

  const renderQr = async (): Promise<void> => {
    if (!input || !sizeInput || !marginInput || !canvas || !download || !error) return;

    try {
      error.textContent = "";
      await QRCode.toCanvas(canvas, input.value || " ", {
        width: Number(sizeInput.value),
        margin: Number(marginInput.value),
        color: { dark: "#14213d", light: "#ffffff" }
      });
      download.href = canvas.toDataURL("image/png");
    } catch {
      error.textContent = "Could not generate a QR code for this input.";
    }
  };

  input?.addEventListener("input", renderQr);
  sizeInput?.addEventListener("input", renderQr);
  marginInput?.addEventListener("input", renderQr);
  root?.querySelector<HTMLButtonElement>("[data-qr-render]")?.addEventListener("click", renderQr);
  renderQr();
</script>
