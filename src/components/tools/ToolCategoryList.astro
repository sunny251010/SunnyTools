---
import type { Tool, ToolCategory } from "../../types/tool";
import { withBasePath } from "../../utils/seo";

interface Props {
  categories: ToolCategory[];
  tools: Tool[];
}

const { categories, tools } = Astro.props;
const getCount = (categoryId: string): number =>
  tools.filter((tool) => tool.categoryId === categoryId).length;
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
  {
    categories.map((category) => (
      <a
        href={withBasePath(`/categories/${category.slug}`)}
        class="rounded-md border border-slate-200 bg-white p-5 shadow-sm hover:border-teal-200 hover:shadow-soft"
      >
        <span class="text-sm font-semibold text-brand-teal">{getCount(category.id)} tools</span>
        <h3 class="mt-3 text-base font-semibold text-ink">{category.name}</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">{category.description}</p>
      </a>
    ))
  }
</div>
