---
import type { ToolCategory } from "../../types/tool";

interface Props {
  categories: ToolCategory[];
}

const { categories } = Astro.props;
---

<section class="rounded-md border border-slate-200 bg-white p-4 shadow-sm sm:p-5" data-tool-search-root>
  <div class="grid gap-3 md:grid-cols-[1fr_220px]">
    <div>
      <label class="sr-only" for="tool-search-input">Search tools</label>
      <input
        id="tool-search-input"
        type="search"
        placeholder="Search by name, keyword, or task"
        class="h-11 w-full rounded-md border border-slate-300 bg-white px-3 text-sm text-ink shadow-sm focus:border-brand-teal"
        data-tool-search-input
      />
    </div>
    <div>
      <label class="sr-only" for="tool-category-filter">Filter by category</label>
      <select
        id="tool-category-filter"
        class="h-11 w-full rounded-md border border-slate-300 bg-white px-3 text-sm text-ink shadow-sm focus:border-brand-teal"
        data-tool-category-filter
      >
        <option value="">All categories</option>
        {categories.map((category) => <option value={category.id}>{category.name}</option>)}
      </select>
    </div>
  </div>
  <p class="mt-3 text-sm text-slate-500" data-tool-search-count></p>
  <div class="mt-5">
    <slot />
    <p
      class="rounded-md border border-slate-200 bg-slate-50 p-5 text-sm text-slate-600"
      data-tool-search-empty
      hidden
    >
      No matching tools found.
    </p>
  </div>
</section>

<script>
  const normalizeValue = (value: string): string => value.trim().toLowerCase();

  document.querySelectorAll<HTMLElement>("[data-tool-search-root]").forEach((root) => {
    const input = root.querySelector<HTMLInputElement>("[data-tool-search-input]");
    const categoryFilter = root.querySelector<HTMLSelectElement>("[data-tool-category-filter]");
    const count = root.querySelector<HTMLElement>("[data-tool-search-count]");
    const emptyState = root.querySelector<HTMLElement>("[data-tool-search-empty]");
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-tool-card]"));

    if (!input || !categoryFilter || !count || !emptyState) {
      return;
    }

    const applyFilters = (): void => {
      const query = normalizeValue(input.value);
      const categoryId = categoryFilter.value;
      let visibleCount = 0;

      cards.forEach((card) => {
        const searchableText = normalizeValue(
          [
            card.dataset.name,
            card.dataset.description,
            card.dataset.keywords,
            card.dataset.status
          ]
            .filter(Boolean)
            .join(" ")
        );
        const matchesQuery = !query || searchableText.includes(query);
        const matchesCategory = !categoryId || card.dataset.categoryId === categoryId;
        const shouldShow = matchesQuery && matchesCategory;

        card.hidden = !shouldShow;
        if (shouldShow) {
          visibleCount += 1;
        }
      });

      count.textContent = `${visibleCount} ${visibleCount === 1 ? "tool" : "tools"} shown`;
      emptyState.hidden = visibleCount > 0;
    };

    const params = new URLSearchParams(window.location.search);
    const queryParam = params.get("q");
    const categoryParam = params.get("category");

    if (queryParam) {
      input.value = queryParam;
    }

    if (categoryParam) {
      categoryFilter.value = categoryParam;
    }

    input.addEventListener("input", applyFilters);
    categoryFilter.addEventListener("change", applyFilters);
    applyFilters();
  });
</script>
