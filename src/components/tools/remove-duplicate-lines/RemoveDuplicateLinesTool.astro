---
import { defaultLocale, type Locale } from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = getMessages(locale).toolUi;
---

<div class="space-y-5" data-duplicate-lines data-copied={copy.shared.copied} data-processed={copy.duplicateLines.processed}>
  <div class="grid gap-4 lg:grid-cols-2">
    <div>
      <label for="duplicate-lines-input" class="mb-2 block text-sm font-semibold text-ink">{copy.shared.input}</label>
      <textarea
        id="duplicate-lines-input"
        class="min-h-72 w-full rounded-md border border-slate-300 bg-slate-50 p-4 font-mono text-sm leading-7 text-ink shadow-inner focus:border-brand-teal focus:bg-white"
        data-duplicate-input></textarea>
    </div>
    <div>
      <label for="duplicate-lines-output" class="mb-2 block text-sm font-semibold text-ink">{copy.shared.output}</label>
      <textarea
        id="duplicate-lines-output"
        class="min-h-72 w-full rounded-md border border-slate-300 bg-white p-4 font-mono text-sm leading-7 text-ink shadow-inner"
        readonly
        data-duplicate-output></textarea>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <label class="flex items-center gap-2 text-sm font-semibold text-ink">
      <input class="h-4 w-4 accent-brand-teal" type="checkbox" checked data-duplicate-trim />
      {copy.duplicateLines.trimLines}
    </label>
    <label class="flex items-center gap-2 text-sm font-semibold text-ink">
      <input class="h-4 w-4 accent-brand-teal" type="checkbox" checked data-duplicate-case />
      {copy.duplicateLines.caseSensitive}
    </label>
    <label class="flex items-center gap-2 text-sm font-semibold text-ink">
      <input class="h-4 w-4 accent-brand-teal" type="checkbox" data-duplicate-empty />
      {copy.duplicateLines.skipEmpty}
    </label>
  </div>

  <div class="grid gap-3 sm:grid-cols-3">
    <div class="rounded-md border border-slate-200 bg-slate-50 p-3">
      <p class="text-xs font-semibold uppercase text-slate-500">{copy.duplicateLines.inputLines}</p>
      <p class="mt-1 text-2xl font-semibold text-ink" data-duplicate-input-count>0</p>
    </div>
    <div class="rounded-md border border-slate-200 bg-slate-50 p-3">
      <p class="text-xs font-semibold uppercase text-slate-500">{copy.duplicateLines.uniqueLines}</p>
      <p class="mt-1 text-2xl font-semibold text-ink" data-duplicate-unique-count>0</p>
    </div>
    <div class="rounded-md border border-slate-200 bg-slate-50 p-3">
      <p class="text-xs font-semibold uppercase text-slate-500">{copy.duplicateLines.duplicatesRemoved}</p>
      <p class="mt-1 text-2xl font-semibold text-ink" data-duplicate-removed-count>0</p>
    </div>
  </div>

  <div class="flex flex-wrap gap-3">
    <button type="button" class="rounded-md bg-brand-teal px-4 py-2 text-sm font-semibold text-white hover:bg-teal-800" data-duplicate-process>
      {copy.shared.convert}
    </button>
    <button type="button" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-teal-200 hover:text-brand-teal" data-duplicate-copy>
      {copy.shared.copy}
    </button>
    <button type="button" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-teal-200 hover:text-brand-teal" data-duplicate-clear>
      {copy.shared.clear}
    </button>
  </div>
  <p class="text-sm font-medium text-emerald-700" role="status" data-duplicate-status></p>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-duplicate-lines]");
  const input = root?.querySelector<HTMLTextAreaElement>("[data-duplicate-input]");
  const output = root?.querySelector<HTMLTextAreaElement>("[data-duplicate-output]");
  const trimInput = root?.querySelector<HTMLInputElement>("[data-duplicate-trim]");
  const caseInput = root?.querySelector<HTMLInputElement>("[data-duplicate-case]");
  const emptyInput = root?.querySelector<HTMLInputElement>("[data-duplicate-empty]");
  const inputCount = root?.querySelector<HTMLElement>("[data-duplicate-input-count]");
  const uniqueCount = root?.querySelector<HTMLElement>("[data-duplicate-unique-count]");
  const removedCount = root?.querySelector<HTMLElement>("[data-duplicate-removed-count]");
  const status = root?.querySelector<HTMLElement>("[data-duplicate-status]");
  const copied = root?.dataset.copied ?? "Copied.";
  const processed = root?.dataset.processed ?? "Duplicates removed.";

  const normalizeLine = (line: string): string => {
    const trimmed = trimInput?.checked ? line.trim() : line;
    return caseInput?.checked ? trimmed : trimmed.toLocaleLowerCase();
  };

  const process = (): void => {
    if (!input || !output || !inputCount || !uniqueCount || !removedCount) return;

    const lines = input.value.split(/\r?\n/);
    const seen = new Set<string>();
    const unique: string[] = [];

    lines.forEach((line) => {
      const value = trimInput?.checked ? line.trim() : line;
      if (emptyInput?.checked && value.length === 0) return;

      const key = normalizeLine(line);
      if (seen.has(key)) return;

      seen.add(key);
      unique.push(value);
    });

    output.value = unique.join("\n");
    inputCount.textContent = String(input.value.length === 0 ? 0 : lines.length);
    uniqueCount.textContent = String(unique.length);
    removedCount.textContent = String(Math.max(0, lines.length - unique.length));
    if (status) status.textContent = processed;
  };

  const clear = (): void => {
    if (!input || !output || !inputCount || !uniqueCount || !removedCount || !status) return;
    input.value = "";
    output.value = "";
    inputCount.textContent = "0";
    uniqueCount.textContent = "0";
    removedCount.textContent = "0";
    status.textContent = "";
  };

  root?.querySelector<HTMLButtonElement>("[data-duplicate-process]")?.addEventListener("click", process);
  root?.querySelector<HTMLButtonElement>("[data-duplicate-copy]")?.addEventListener("click", async () => {
    if (!output || !status) return;
    await navigator.clipboard.writeText(output.value);
    status.textContent = copied;
  });
  root?.querySelector<HTMLButtonElement>("[data-duplicate-clear]")?.addEventListener("click", clear);
  input?.addEventListener("input", process);
  trimInput?.addEventListener("change", process);
  caseInput?.addEventListener("change", process);
  emptyInput?.addEventListener("change", process);
</script>
