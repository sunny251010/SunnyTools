---
import { defaultLocale, type Locale } from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = getMessages(locale).toolUi;
---

<div
  class="space-y-5"
  data-json-formatter
  data-valid={copy.json.valid}
  data-invalid={copy.json.invalid}
  data-copied={copy.shared.copied}
>
  <div class="grid gap-4 lg:grid-cols-2">
    <div>
      <label for="json-input" class="mb-2 block text-sm font-semibold text-ink">{copy.json.input}</label>
      <textarea id="json-input" class="min-h-80 w-full rounded-md border border-slate-300 bg-slate-50 p-4 font-mono text-sm leading-6 text-ink shadow-inner focus:border-brand-teal focus:bg-white" placeholder='{"hello":"world"}' data-json-input></textarea>
    </div>
    <div>
      <label for="json-output" class="mb-2 block text-sm font-semibold text-ink">{copy.shared.output}</label>
      <textarea id="json-output" class="min-h-80 w-full rounded-md border border-slate-300 bg-white p-4 font-mono text-sm leading-6 text-ink shadow-inner" readonly data-json-output></textarea>
    </div>
  </div>
  <div class="flex flex-wrap gap-3">
    <button type="button" class="rounded-md bg-brand-teal px-4 py-2 text-sm font-semibold text-white hover:bg-teal-800" data-json-format>{copy.json.format}</button>
    <button type="button" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-teal-200 hover:text-brand-teal" data-json-minify>{copy.json.minify}</button>
    <button type="button" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-teal-200 hover:text-brand-teal" data-json-copy>{copy.shared.copy}</button>
  </div>
  <p class="text-sm font-medium" role="status" data-json-status></p>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-json-formatter]");
  const input = root?.querySelector<HTMLTextAreaElement>("[data-json-input]");
  const output = root?.querySelector<HTMLTextAreaElement>("[data-json-output]");
  const status = root?.querySelector<HTMLElement>("[data-json-status]");
  const valid = root?.dataset.valid ?? "Valid JSON.";
  const invalid = root?.dataset.invalid ?? "Invalid JSON.";
  const copied = root?.dataset.copied ?? "Copied.";

  const transform = (space: number): void => {
    if (!input || !output || !status) return;

    try {
      const parsed = JSON.parse(input.value);
      output.value = JSON.stringify(parsed, null, space);
      status.className = "text-sm font-medium text-emerald-700";
      status.textContent = valid;
    } catch (error) {
      output.value = "";
      status.className = "text-sm font-medium text-rose-700";
      status.textContent = error instanceof Error ? error.message : invalid;
    }
  };

  root?.querySelector<HTMLButtonElement>("[data-json-format]")?.addEventListener("click", () => transform(2));
  root?.querySelector<HTMLButtonElement>("[data-json-minify]")?.addEventListener("click", () => transform(0));
  root?.querySelector<HTMLButtonElement>("[data-json-copy]")?.addEventListener("click", async () => {
    if (!output || !status) return;
    await navigator.clipboard.writeText(output.value);
    status.className = "text-sm font-medium text-emerald-700";
    status.textContent = copied;
  });
</script>
