---
import { defaultLocale, type Locale } from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = getMessages(locale).toolUi;
---

<div class="space-y-5" data-js-minifier data-copied={copy.shared.copied} data-minified={copy.minifier.minifiedStatus} data-invalid={copy.minifier.invalidJs}>
  <div class="grid gap-4 lg:grid-cols-2">
    <div>
      <label for="js-minify-input" class="mb-2 block text-sm font-semibold text-ink">{copy.minifier.source}</label>
      <textarea id="js-minify-input" class="min-h-80 w-full rounded-md border border-slate-300 bg-slate-50 p-4 font-mono text-sm leading-6 text-ink shadow-inner focus:border-brand-teal focus:bg-white" data-js-input></textarea>
    </div>
    <div>
      <label for="js-minify-output" class="mb-2 block text-sm font-semibold text-ink">{copy.minifier.minified}</label>
      <textarea id="js-minify-output" class="min-h-80 w-full rounded-md border border-slate-300 bg-white p-4 font-mono text-sm leading-6 text-ink shadow-inner" readonly data-js-output></textarea>
    </div>
  </div>
  <div class="grid gap-3 sm:grid-cols-3">
    <div class="rounded-md border border-slate-200 bg-slate-50 p-3"><p class="text-xs font-semibold uppercase text-slate-500">{copy.minifier.before}</p><p class="mt-1 text-2xl font-semibold text-ink" data-js-before>0 B</p></div>
    <div class="rounded-md border border-slate-200 bg-slate-50 p-3"><p class="text-xs font-semibold uppercase text-slate-500">{copy.minifier.after}</p><p class="mt-1 text-2xl font-semibold text-ink" data-js-after>0 B</p></div>
    <div class="rounded-md border border-slate-200 bg-slate-50 p-3"><p class="text-xs font-semibold uppercase text-slate-500">{copy.minifier.saved}</p><p class="mt-1 text-2xl font-semibold text-ink" data-js-saved>0%</p></div>
  </div>
  <label class="flex items-center gap-2 text-sm font-semibold text-ink">
    <input class="h-4 w-4 accent-brand-teal" type="checkbox" data-js-comments />
    {copy.minifier.keepComments}
  </label>
  <div class="flex flex-wrap gap-3">
    <button type="button" class="rounded-md bg-brand-teal px-4 py-2 text-sm font-semibold text-white hover:bg-teal-800" data-js-run>{copy.json.minify}</button>
    <button type="button" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-teal-200 hover:text-brand-teal" data-js-copy>{copy.shared.copy}</button>
    <button type="button" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-teal-200 hover:text-brand-teal" data-js-download>{copy.shared.downloadJs}</button>
    <button type="button" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-teal-200 hover:text-brand-teal" data-js-example>{copy.shared.loadExample}</button>
    <button type="button" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-teal-200 hover:text-brand-teal" data-js-clear>{copy.shared.clear}</button>
  </div>
  <p class="text-sm font-medium" role="status" data-js-status></p>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-js-minifier]");
  const input = root?.querySelector<HTMLTextAreaElement>("[data-js-input]");
  const output = root?.querySelector<HTMLTextAreaElement>("[data-js-output]");
  const keepCommentsInput = root?.querySelector<HTMLInputElement>("[data-js-comments]");
  const beforeText = root?.querySelector<HTMLElement>("[data-js-before]");
  const afterText = root?.querySelector<HTMLElement>("[data-js-after]");
  const savedText = root?.querySelector<HTMLElement>("[data-js-saved]");
  const status = root?.querySelector<HTMLElement>("[data-js-status]");
  const copied = root?.dataset.copied ?? "Copied.";
  const minified = root?.dataset.minified ?? "Minified locally.";
  const invalid = root?.dataset.invalid ?? "JavaScript has unfinished strings, comments, templates, or brackets.";

  const size = (value: string): number => new Blob([value]).size;
  const punct = new Set(["{", "}", "(", ")", "[", "]", ";", ",", ":", "+", "-", "*", "/", "%", "=", "<", ">", "!", "?", "&", "|"]);

  const updateStats = (before: string, after: string): void => {
    if (!beforeText || !afterText || !savedText) return;
    const beforeSize = size(before);
    const afterSize = size(after);
    const saved = beforeSize > 0 ? Math.max(0, Math.round(((beforeSize - afterSize) / beforeSize) * 100)) : 0;
    beforeText.textContent = `${beforeSize} B`;
    afterText.textContent = `${afterSize} B`;
    savedText.textContent = `${saved}%`;
  };

  const validate = (source: string): boolean => {
    const stack: string[] = [];
    let quote = "";
    let blockComment = false;
    let lineComment = false;
    for (let index = 0; index < source.length; index += 1) {
      const char = source[index];
      const next = source[index + 1];
      const previous = source[index - 1];
      if (lineComment) {
        if (char === "\n") lineComment = false;
        continue;
      }
      if (blockComment) {
        if (char === "*" && next === "/") {
          blockComment = false;
          index += 1;
        }
        continue;
      }
      if (quote) {
        if (char === quote && previous !== "\\") quote = "";
        continue;
      }
      if (char === "/" && next === "/") {
        lineComment = true;
        index += 1;
        continue;
      }
      if (char === "/" && next === "*") {
        blockComment = true;
        index += 1;
        continue;
      }
      if (char === '"' || char === "'" || char === "`") quote = char;
      if ("({[".includes(char)) stack.push(char);
      if (")}]".includes(char)) {
        const open = stack.pop();
        if ((char === ")" && open !== "(") || (char === "}" && open !== "{") || (char === "]" && open !== "[")) return false;
      }
    }
    return stack.length === 0 && !quote && !blockComment;
  };

  const minifyJs = (source: string, keepComments: boolean): string => {
    let result = "";
    let quote = "";
    let blockComment = false;
    let lineComment = false;
    let pendingSpace = false;

    for (let index = 0; index < source.length; index += 1) {
      const char = source[index];
      const next = source[index + 1];
      const previousOutput = result[result.length - 1] ?? "";

      if (lineComment) {
        if (keepComments) result += char;
        if (char === "\n") lineComment = false;
        continue;
      }
      if (blockComment) {
        if (keepComments) result += char;
        if (char === "*" && next === "/") {
          if (keepComments) result += next;
          blockComment = false;
          index += 1;
        }
        continue;
      }
      if (quote) {
        result += char;
        if (char === quote && source[index - 1] !== "\\") quote = "";
        continue;
      }
      if (char === "/" && next === "/") {
        lineComment = true;
        if (keepComments) result += char + next;
        index += 1;
        continue;
      }
      if (char === "/" && next === "*") {
        blockComment = true;
        if (keepComments) result += char + next;
        index += 1;
        continue;
      }
      if (char === '"' || char === "'" || char === "`") {
        if (pendingSpace && /[A-Za-z0-9_$]/.test(previousOutput)) result += " ";
        pendingSpace = false;
        quote = char;
        result += char;
        continue;
      }
      if (/\s/.test(char)) {
        pendingSpace = true;
        continue;
      }
      if (pendingSpace && /[A-Za-z0-9_$]/.test(previousOutput) && /[A-Za-z0-9_$]/.test(char)) {
        result += " ";
      }
      pendingSpace = false;
      if (punct.has(char) && result.endsWith(" ")) result = result.trimEnd();
      result += char;
    }
    return result.trim();
  };

  const run = (): void => {
    if (!input || !output || !status) return;
    if (!validate(input.value)) {
      status.className = "text-sm font-medium text-rose-700";
      status.textContent = invalid;
      output.value = "";
      updateStats(input.value, "");
      return;
    }
    output.value = minifyJs(input.value, Boolean(keepCommentsInput?.checked));
    updateStats(input.value, output.value);
    status.className = "text-sm font-medium text-emerald-700";
    status.textContent = minified;
  };

  const downloadText = (filename: string, text: string): void => {
    const link = document.createElement("a");
    link.href = URL.createObjectURL(new Blob([text], { type: "text/javascript;charset=utf-8" }));
    link.download = filename;
    link.click();
    URL.revokeObjectURL(link.href);
  };

  root?.querySelector<HTMLButtonElement>("[data-js-run]")?.addEventListener("click", run);
  root?.querySelector<HTMLButtonElement>("[data-js-copy]")?.addEventListener("click", async () => {
    if (!output || !status) return;
    await navigator.clipboard.writeText(output.value);
    status.textContent = copied;
  });
  root?.querySelector<HTMLButtonElement>("[data-js-download]")?.addEventListener("click", () => {
    if (output?.value) downloadText("script.min.js", output.value);
  });
  root?.querySelector<HTMLButtonElement>("[data-js-example]")?.addEventListener("click", () => {
    if (!input) return;
    input.value = "// SunnyTools example\nfunction greet(name) {\n  const message = `Hello, ${name}`;\n  return message;\n}\nconsole.log(greet('Sunny'));\n";
    run();
  });
  root?.querySelector<HTMLButtonElement>("[data-js-clear]")?.addEventListener("click", () => {
    if (!input || !output || !status) return;
    input.value = "";
    output.value = "";
    status.textContent = "";
    updateStats("", "");
  });
</script>
