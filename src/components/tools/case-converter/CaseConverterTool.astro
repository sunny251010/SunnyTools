---
import { defaultLocale, type Locale } from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = getMessages(locale).toolUi;
const modes = [
  ["upper", copy.caseConverter.upper],
  ["lower", copy.caseConverter.lower],
  ["title", copy.caseConverter.title],
  ["sentence", copy.caseConverter.sentence],
  ["kebab", copy.caseConverter.kebab],
  ["snake", copy.caseConverter.snake],
  ["camel", copy.caseConverter.camel]
];
---

<div class="space-y-5" data-case-converter data-copied={copy.shared.copied}>
  <div class="grid gap-4 lg:grid-cols-2">
    <div>
      <label for="case-input" class="mb-2 block text-sm font-semibold text-ink">{copy.shared.input}</label>
      <textarea
        id="case-input"
        class="min-h-64 w-full rounded-md border border-slate-300 bg-slate-50 p-4 text-base leading-7 text-ink shadow-inner focus:border-brand-teal focus:bg-white"
        placeholder={copy.caseConverter.placeholder}
        data-case-input></textarea>
    </div>
    <div>
      <label for="case-output" class="mb-2 block text-sm font-semibold text-ink">{copy.shared.output}</label>
      <textarea
        id="case-output"
        class="min-h-64 w-full rounded-md border border-slate-300 bg-white p-4 text-base leading-7 text-ink shadow-inner"
        readonly
        data-case-output></textarea>
    </div>
  </div>
  <div class="flex flex-wrap gap-3">
    {
      modes.map(([mode, label]) => (
        <button
          type="button"
          class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:border-teal-200 hover:text-brand-teal"
          data-case-mode={mode}
        >
          {label}
        </button>
      ))
    }
    <button
      type="button"
      class="rounded-md bg-brand-teal px-3 py-2 text-sm font-semibold text-white hover:bg-teal-800"
      data-case-copy
    >
      {copy.shared.copy}
    </button>
  </div>
  <p class="text-sm font-medium text-emerald-700" role="status" data-case-status></p>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-case-converter]");
  const input = root?.querySelector<HTMLTextAreaElement>("[data-case-input]");
  const output = root?.querySelector<HTMLTextAreaElement>("[data-case-output]");
  const status = root?.querySelector<HTMLElement>("[data-case-status]");
  const copied = root?.dataset.copied ?? "Copied.";

  const words = (value: string): string[] =>
    value
      .trim()
      .split(/[^A-Za-z0-9]+/)
      .filter(Boolean);

  const titleCase = (value: string): string =>
    value.toLowerCase().replace(/\b[\p{L}\p{N}]/gu, (char) => char.toUpperCase());

  const sentenceCase = (value: string): string =>
    value
      .toLowerCase()
      .replace(/(^\s*\p{L}|[.!?]\s+\p{L})/gu, (match) => match.toUpperCase());

  const convert = (mode: string): void => {
    if (!input || !output) return;

    const value = input.value;
    const normalizedWords = words(value);
    const converters: Record<string, string> = {
      upper: value.toUpperCase(),
      lower: value.toLowerCase(),
      title: titleCase(value),
      sentence: sentenceCase(value),
      kebab: normalizedWords.map((word) => word.toLowerCase()).join("-"),
      snake: normalizedWords.map((word) => word.toLowerCase()).join("_"),
      camel: normalizedWords
        .map((word, index) => {
          const lower = word.toLowerCase();
          return index === 0 ? lower : lower.charAt(0).toUpperCase() + lower.slice(1);
        })
        .join("")
    };

    output.value = converters[mode] ?? value;
  };

  root?.querySelectorAll<HTMLButtonElement>("[data-case-mode]").forEach((button) => {
    button.addEventListener("click", () => convert(button.dataset.caseMode ?? "lower"));
  });

  root?.querySelector<HTMLButtonElement>("[data-case-copy]")?.addEventListener("click", async () => {
    if (!output || !status) return;
    await navigator.clipboard.writeText(output.value);
    status.textContent = copied;
    window.setTimeout(() => {
      status.textContent = "";
    }, 1500);
  });
</script>
