---
import { defaultLocale, type Locale } from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = getMessages(locale).toolUi;
---

<div
  class="space-y-5"
  data-url-tool
  data-encoded={copy.url.encoded}
  data-decoded={copy.url.decoded}
  data-malformed={copy.url.malformed}
  data-copied={copy.shared.copied}
>
  <div class="grid gap-4 lg:grid-cols-2">
    <textarea class="min-h-64 w-full rounded-md border border-slate-300 bg-slate-50 p-4 font-mono text-sm leading-6 text-ink shadow-inner" placeholder={copy.url.placeholder} aria-label={copy.url.inputAria} data-url-input></textarea>
    <textarea class="min-h-64 w-full rounded-md border border-slate-300 bg-white p-4 font-mono text-sm leading-6 text-ink shadow-inner" readonly aria-label={copy.url.outputAria} data-url-output></textarea>
  </div>
  <div class="flex flex-wrap gap-3">
    <button type="button" class="rounded-md bg-brand-teal px-4 py-2 text-sm font-semibold text-white hover:bg-teal-800" data-url-encode>{copy.shared.encode}</button>
    <button type="button" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-teal-200 hover:text-brand-teal" data-url-decode>{copy.shared.decode}</button>
    <button type="button" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-teal-200 hover:text-brand-teal" data-url-copy>{copy.shared.copy}</button>
  </div>
  <p class="text-sm font-medium" role="status" data-url-status></p>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-url-tool]");
  const input = root?.querySelector<HTMLTextAreaElement>("[data-url-input]");
  const output = root?.querySelector<HTMLTextAreaElement>("[data-url-output]");
  const status = root?.querySelector<HTMLElement>("[data-url-status]");
  const encoded = root?.dataset.encoded ?? "Encoded.";
  const decoded = root?.dataset.decoded ?? "Decoded.";
  const malformed = root?.dataset.malformed ?? "Malformed URL encoded input.";
  const copied = root?.dataset.copied ?? "Copied.";

  const run = (mode: "encode" | "decode"): void => {
    if (!input || !output || !status) return;
    try {
      output.value =
        mode === "encode" ? encodeURIComponent(input.value) : decodeURIComponent(input.value);
      status.className = "text-sm font-medium text-emerald-700";
      status.textContent = mode === "encode" ? encoded : decoded;
    } catch {
      output.value = "";
      status.className = "text-sm font-medium text-rose-700";
      status.textContent = malformed;
    }
  };

  root?.querySelector<HTMLButtonElement>("[data-url-encode]")?.addEventListener("click", () => run("encode"));
  root?.querySelector<HTMLButtonElement>("[data-url-decode]")?.addEventListener("click", () => run("decode"));
  root?.querySelector<HTMLButtonElement>("[data-url-copy]")?.addEventListener("click", async () => {
    if (!output || !status) return;
    await navigator.clipboard.writeText(output.value);
    status.className = "text-sm font-medium text-emerald-700";
    status.textContent = copied;
  });
</script>
