---
import { getMainNavigation } from "../../data/navigation";
import { defaultLocale, localizedPath, stripLocaleFromPath, type Locale } from "../../i18n/config";
import { getMessages } from "../../i18n/messages";
import { siteConfig, withBasePath } from "../../utils/seo";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const { site } = getMessages(locale);
const mainNavigation = getMainNavigation(locale);
const currentPath = stripLocaleFromPath(Astro.url.pathname).replace(/\/$/, "") || "/";
const isActive = (href: string): boolean => {
  const path = new URL(href, siteConfig.url).pathname.replace(/\/$/, "") || "/";
  return path === "/" ? currentPath === "/" : currentPath === path;
};
---

<div class="md:hidden">
  <button
    type="button"
    class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-slate-200 bg-white text-slate-700 shadow-sm"
    aria-label={site.openNavigation}
    aria-expanded="false"
    data-mobile-menu-button
  >
    <span class="flex flex-col gap-1.5" aria-hidden="true">
      <span class="h-0.5 w-5 rounded-full bg-current"></span>
      <span class="h-0.5 w-5 rounded-full bg-current"></span>
      <span class="h-0.5 w-5 rounded-full bg-current"></span>
    </span>
  </button>
  <nav
    class="absolute left-4 right-4 top-16 rounded-md border border-slate-200 bg-white p-3 shadow-soft"
    aria-label={site.mobileNavigation}
    data-mobile-menu-panel
    hidden
  >
    <div class="grid gap-1">
      {
        mainNavigation.map((item) => (
          <a
            href={withBasePath(localizedPath(item.href, locale))}
            class:list={[
              "rounded-md px-3 py-2 text-sm font-medium",
              isActive(item.href)
                ? "bg-teal-50 text-brand-teal"
                : "text-slate-700 hover:bg-slate-50 hover:text-brand-teal"
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <div class="mt-2 border-t border-slate-100 pt-2">
        <LanguageSwitcher locale={locale} compact />
      </div>
    </div>
  </nav>
</div>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>("[data-mobile-menu-button]");
  const menuPanel = document.querySelector<HTMLElement>("[data-mobile-menu-panel]");

  if (menuButton && menuPanel) {
    menuButton.addEventListener("click", () => {
      const isExpanded = menuButton.getAttribute("aria-expanded") === "true";
      menuButton.setAttribute("aria-expanded", String(!isExpanded));
      menuPanel.hidden = isExpanded;
    });
  }
</script>
