---
import {
  getAlternateLinks,
  localeDetails,
  stripLocaleFromPath,
  type Locale
} from "../../i18n/config";
import { getMessages } from "../../i18n/messages";
import { withBasePath } from "../../utils/seo";

interface Props {
  locale: Locale;
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const logicalPath = stripLocaleFromPath(Astro.url.pathname);
const alternates = getAlternateLinks(logicalPath);
const { common } = getMessages(locale);
---

<div class:list={["flex items-center", compact ? "gap-2" : "gap-1"]} aria-label={common.language}>
  {
    alternates.map((alternate) => {
      const isCurrent = alternate.locale === locale;

      return (
        <a
          href={withBasePath(alternate.href)}
          class:list={[
            "rounded-md px-2.5 py-2 text-xs font-semibold",
            isCurrent
              ? "bg-teal-50 text-brand-teal"
              : "text-slate-600 hover:bg-slate-50 hover:text-brand-teal"
          ]}
          aria-current={isCurrent ? "true" : undefined}
          title={localeDetails[alternate.locale].label}
        >
          {localeDetails[alternate.locale].shortLabel}
        </a>
      );
    })
  }
</div>
