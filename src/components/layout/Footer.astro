---
import { footerNavigation } from "../../data/navigation";
import { siteConfig, withBasePath } from "../../utils/seo";
import Container from "../common/Container.astro";
---

<footer class="mt-auto border-t border-slate-200 bg-white">
  <Container class="py-10">
    <div class="grid gap-8 md:grid-cols-[1.2fr_1fr] md:items-start">
      <div>
        <a href={withBasePath("/")} class="flex items-center gap-3 font-semibold text-ink">
          <span class="grid h-9 w-9 place-items-center rounded-md bg-brand-teal text-sm text-white">ST</span>
          <span>{siteConfig.name}</span>
        </a>
        <p class="mt-4 max-w-xl text-sm leading-6 text-slate-600">
          Fast, private, browser-based utilities built for everyday writing, development, and
          calculation tasks.
        </p>
      </div>
      <nav class="flex flex-wrap gap-x-5 gap-y-3 text-sm font-medium text-slate-600" aria-label="Footer">
        {footerNavigation.map((item) => <a class="hover:text-brand-teal" href={withBasePath(item.href)}>{item.label}</a>)}
      </nav>
    </div>
    <p class="mt-8 text-sm text-slate-500">
      Copyright {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
    </p>
  </Container>
</footer>
