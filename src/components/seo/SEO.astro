---
import { createPageSeo, siteConfig } from "../../utils/seo";
import type { AlternateLink, Locale } from "../../i18n/config";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  robots?: string;
  locale?: Locale;
  alternates?: AlternateLink[];
  type?: "website" | "article";
}

const {
  title,
  description,
  path,
  image,
  robots,
  locale,
  alternates = [],
  type = "website"
} = Astro.props;
const seo = createPageSeo({ title, description, path, image, robots, locale });
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<meta name="robots" content={seo.robots} />
<link rel="canonical" href={seo.canonical} />
{alternates.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />)}
{
  alternates.length > 0 && (
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
  )
}

<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={seo.image} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.image} />
<meta name="twitter:site" content={siteConfig.twitterHandle} />
