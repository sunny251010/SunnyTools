---
import ToolLayout from "../layout/ToolLayout.astro";
import Base64EncoderDecoderTool from "../tools/base64-encoder-decoder/Base64EncoderDecoderTool.astro";
import CaseConverterTool from "../tools/case-converter/CaseConverterTool.astro";
import ColorConverterTool from "../tools/color-converter/ColorConverterTool.astro";
import CssMinifierTool from "../tools/css-minifier/CssMinifierTool.astro";
import HtmlFormatterTool from "../tools/html-formatter/HtmlFormatterTool.astro";
import JavaScriptMinifierTool from "../tools/javascript-minifier/JavaScriptMinifierTool.astro";
import JsonToolsTool from "../tools/json-tools/JsonToolsTool.astro";
import LineToolsTool from "../tools/line-tools/LineToolsTool.astro";
import LoremIpsumGeneratorTool from "../tools/lorem-ipsum-generator/LoremIpsumGeneratorTool.astro";
import MarkdownPreviewerTool from "../tools/markdown-previewer/MarkdownPreviewerTool.astro";
import PasswordGeneratorTool from "../tools/password-generator/PasswordGeneratorTool.astro";
import PercentageCalculatorTool from "../tools/percentage-calculator/PercentageCalculatorTool.astro";
import QrCodeGeneratorTool from "../tools/qr-code-generator/QrCodeGeneratorTool.astro";
import RandomNumberGeneratorTool from "../tools/random-number-generator/RandomNumberGeneratorTool.astro";
import RegexTesterTool from "../tools/regex-tester/RegexTesterTool.astro";
import TextCounterTool from "../tools/text-counter/TextCounterTool.astro";
import TextCompareTool from "../tools/text-compare/TextCompareTool.astro";
import TimestampConverterTool from "../tools/timestamp-converter/TimestampConverterTool.astro";
import UrlEncoderDecoderTool from "../tools/url-encoder-decoder/UrlEncoderDecoderTool.astro";
import UuidGeneratorTool from "../tools/uuid-generator/UuidGeneratorTool.astro";
import SlugGeneratorTool from "../tools/slug-generator/SlugGeneratorTool.astro";
import { getRelatedTools } from "../../data/tools";
import { getToolContent } from "../../data/toolContent";
import { defaultLocale, type Locale } from "../../i18n/config";
import { getMessages } from "../../i18n/messages";
import type { Tool } from "../../types/tool";

interface Props {
  tool: Tool;
  locale?: Locale;
}

const toolComponents = {
  "word-counter": { component: TextCounterTool, defaultMode: "all" },
  "character-counter": { component: TextCounterTool, defaultMode: "characters" },
  "case-converter": CaseConverterTool,
  "remove-duplicate-lines": { component: LineToolsTool, defaultMode: "remove-duplicates" },
  "slug-generator": SlugGeneratorTool,
  "sort-lines": { component: LineToolsTool, defaultMode: "sort" },
  "text-compare": TextCompareTool,
  "lorem-ipsum-generator": LoremIpsumGeneratorTool,
  "qr-code-generator": QrCodeGeneratorTool,
  "password-generator": PasswordGeneratorTool,
  "uuid-generator": UuidGeneratorTool,
  "random-number-generator": RandomNumberGeneratorTool,
  "json-formatter": { component: JsonToolsTool, defaultMode: "format" },
  "json-validator": { component: JsonToolsTool, defaultMode: "validate" },
  "base64-encoder-decoder": Base64EncoderDecoderTool,
  "url-encoder-decoder": UrlEncoderDecoderTool,
  "regex-tester": RegexTesterTool,
  "markdown-previewer": MarkdownPreviewerTool,
  "html-formatter": HtmlFormatterTool,
  "css-minifier": CssMinifierTool,
  "javascript-minifier": JavaScriptMinifierTool,
  "unix-timestamp-converter": TimestampConverterTool,
  "timestamp-converter": TimestampConverterTool,
  "color-converter": ColorConverterTool,
  "percentage-calculator": PercentageCalculatorTool
};

const { tool, locale = defaultLocale } = Astro.props;
const toolConfig = toolComponents[tool.slug as keyof typeof toolComponents];
const ToolComponent = toolConfig && "component" in toolConfig ? toolConfig.component : toolConfig;
const toolMode = toolConfig && "defaultMode" in toolConfig ? toolConfig.defaultMode : undefined;
const content = getToolContent(tool.slug, locale);
const { toolPage } = getMessages(locale);

if (!ToolComponent || !content) {
  throw new Error(`Tool page configuration is missing for ${tool.slug}.`);
}

const relatedTools = getRelatedTools(tool, locale);
const whatIsHeading = toolPage.whatIs.replace("{tool}", tool.name);
---

<ToolLayout tool={tool} relatedTools={relatedTools} locale={locale} faqs={content.faqs}>
  <ToolComponent slot="tool" locale={locale} defaultMode={toolMode as undefined} />

  <Fragment slot="content">
    <h2>{whatIsHeading}</h2>
    <p>{content.intro}</p>

    <h2>{toolPage.howToUse}</h2>
    <p>{content.howToUse}</p>

    <h2>{toolPage.howItWorks}</h2>
    <p>{content.howItWorks}</p>

    <h2>{toolPage.privacy}</h2>
    <p>{content.privacy}</p>
  </Fragment>

  <Fragment slot="faq">
    {
      content.faqs.map((item) => (
        <section>
          <h3 class="font-semibold text-ink">{item.question}</h3>
          <p class="mt-1">{item.answer}</p>
        </section>
      ))
    }
  </Fragment>
</ToolLayout>
