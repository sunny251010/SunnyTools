---
import Breadcrumbs from "../common/Breadcrumbs.astro";
import Container from "../common/Container.astro";
import SectionTitle from "../common/SectionTitle.astro";
import ToolGrid from "../tools/ToolGrid.astro";
import { getListedTools } from "../../data/tools";
import { defaultLocale, localizedPath, type Locale } from "../../i18n/config";
import { getMessages } from "../../i18n/messages";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createBreadcrumbSchema, createCollectionPageSchema } from "../../utils/schema";
import type { ToolCategory } from "../../types/tool";

interface Props {
  category: ToolCategory;
  locale?: Locale;
}

const { category, locale = defaultLocale } = Astro.props;
const { categoryPage, nav } = getMessages(locale);
const tools = getListedTools(locale);
const categoryTools = tools.filter((tool) => tool.categoryId === category.id);
const description =
  locale === "en"
    ? `${category.description} ${categoryPage.descriptionSuffix} ${category.name.toLowerCase()}.`
    : `${category.description} ${categoryPage.descriptionSuffix} ${category.name.toLowerCase()}.`;
const path = localizedPath(`/categories/${category.slug}`, locale);
const breadcrumbItems = [
  { label: nav.home, href: localizedPath("/", locale) },
  { label: category.name }
];
const structuredData = [
  createCollectionPageSchema(category.name, description, path),
  createBreadcrumbSchema(breadcrumbItems)
];
---

<BaseLayout
  title={category.name}
  description={description}
  path={path}
  locale={locale}
  structuredData={structuredData}
>
  <main class="flex-1">
    <Container class="py-10 md:py-14">
      <Breadcrumbs items={breadcrumbItems} />

      <section class="max-w-4xl">
        <p class="text-sm font-semibold uppercase text-brand-teal">{categoryPage.eyebrow}</p>
        <h1 class="mt-3 text-3xl font-semibold text-ink md:text-4xl">{category.name}</h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">{category.description}</p>
      </section>

      <section class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px]">
        <article class="tool-content">
          <h2>{categoryPage.guideTitle}</h2>
          <p>{category.guide}</p>

          <h2>{categoryPage.useCasesTitle}</h2>
          <ul>
            {category.useCases.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <aside class="rounded-md border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-lg font-semibold text-ink">{categoryPage.tipsTitle}</h2>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-slate-600">
            {category.tips.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      </section>

      <section class="mt-10">
        <SectionTitle
          title={`${category.name} ${categoryPage.collectionSuffix}`}
          description={categoryPage.sectionDescription}
        />
        <div class="mt-6">
          <ToolGrid tools={categoryTools} locale={locale} />
        </div>
      </section>
    </Container>
  </main>
</BaseLayout>
