---
import StaticPage from "../../components/pages/StaticPage.astro";
import { isLocale, nonDefaultLocales, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return nonDefaultLocales.map((locale) => ({
    params: { locale },
    props: { locale }
  }));
}

const { locale } = Astro.props as { locale: Locale };

if (!isLocale(locale)) {
  throw new Error(`Unsupported locale: ${locale}`);
}
---

<StaticPage pageKey="about" path="/about" locale={locale} />
