---
import CategoryPage from "../../components/pages/CategoryPage.astro";
import { getCategories } from "../../data/categories";
import { defaultLocale } from "../../i18n/config";
import type { ToolCategory } from "../../types/tool";

export function getStaticPaths() {
  return getCategories(defaultLocale).map((category) => ({
    params: { slug: category.slug },
    props: { category }
  }));
}

const { category } = Astro.props as { category: ToolCategory };
---

<CategoryPage category={category} locale={defaultLocale} />
