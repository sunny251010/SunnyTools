---
import Container from "../../components/common/Container.astro";
import SectionTitle from "../../components/common/SectionTitle.astro";
import ToolGrid from "../../components/tools/ToolGrid.astro";
import { categories } from "../../data/categories";
import { tools } from "../../data/tools";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { ToolCategory } from "../../types/tool";

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category }
  }));
}

const { category } = Astro.props as { category: ToolCategory };
const categoryTools = tools.filter((tool) => tool.categoryId === category.id);
---

<BaseLayout
  title={category.name}
  description={`${category.description} Browse free browser-based ${category.name.toLowerCase()}.`}
  path={`/categories/${category.slug}`}
>
  <main class="flex-1">
    <Container class="py-10 md:py-14">
      <section class="max-w-4xl">
        <p class="text-sm font-semibold uppercase text-brand-teal">Category</p>
        <h1 class="mt-3 text-3xl font-semibold text-ink md:text-4xl">{category.name}</h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">{category.description}</p>
      </section>

      <section class="mt-10">
        <SectionTitle
          title={`${category.name} collection`}
          description="Each tool has its own URL and runs directly in the browser."
        />
        <div class="mt-6">
          <ToolGrid tools={categoryTools} />
        </div>
      </section>
    </Container>
  </main>
</BaseLayout>
