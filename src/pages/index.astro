---
import AdPlaceholder from "../components/common/AdPlaceholder.astro";
import Container from "../components/common/Container.astro";
import SectionTitle from "../components/common/SectionTitle.astro";
import ToolCategoryList from "../components/tools/ToolCategoryList.astro";
import ToolGrid from "../components/tools/ToolGrid.astro";
import { categories } from "../data/categories";
import { activeTools, popularTools, tools } from "../data/tools";
import BaseLayout from "../layouts/BaseLayout.astro";

const popularPreview = popularTools.slice(0, 6);
---

<BaseLayout
  title="Free Online Tools"
  description="Use fast, private, browser-based tools for text, developers, generators, conversions, and calculators."
  path="/"
>
  <main class="flex-1">
    <section class="border-b border-slate-200 bg-white">
      <Container class="py-14 md:py-20">
        <div class="max-w-4xl">
          <p class="text-sm font-semibold uppercase text-brand-teal">Free online utilities</p>
          <h1 class="mt-4 text-4xl font-semibold text-ink md:text-5xl">
            Fast browser-based tools for everyday work.
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
            Count text, generate values, format developer data, and run quick conversions without
            sending your input to a server.
          </p>

          <form action="/tools" method="get" class="mt-8 grid gap-3 sm:grid-cols-[1fr_auto]">
            <label class="sr-only" for="home-tool-search">Search tools</label>
            <input
              id="home-tool-search"
              name="q"
              type="search"
              placeholder="Search for a tool"
              class="h-12 rounded-md border border-slate-300 bg-slate-50 px-4 text-base text-ink shadow-sm focus:border-brand-teal focus:bg-white"
            />
            <button
              type="submit"
              class="rounded-md bg-brand-teal px-5 py-3 text-sm font-semibold text-white hover:bg-teal-800"
            >
              Search
            </button>
          </form>

          <div class="mt-6 flex flex-wrap gap-3 text-sm font-medium text-slate-600">
            <a class="rounded-md border border-slate-200 bg-white px-3 py-2 hover:text-brand-teal" href="/tools">
              Browse all tools
            </a>
            <span class="rounded-md bg-teal-50 px-3 py-2 text-brand-teal">
              {activeTools.length} active now
            </span>
            <span class="rounded-md bg-amber-50 px-3 py-2 text-brand-gold">
              {tools.length} total tools
            </span>
          </div>
        </div>
      </Container>
    </section>

    <Container class="py-10">
      <AdPlaceholder label="Development ad placeholder after hero" />

      <section class="mt-10">
        <SectionTitle
          eyebrow="Popular"
          title="Popular tools"
          description="Start with the tools people reach for most often, including the first production-ready Word Counter."
        />
        <div class="mt-6">
          <ToolGrid tools={popularPreview} />
        </div>
      </section>

      <AdPlaceholder label="Development ad placeholder between tool sections" />

      <section class="mt-12">
        <SectionTitle
          eyebrow="Categories"
          title="Browse by category"
          description="Each category groups related tools with static URLs ready for SEO and internal linking."
        />
        <div class="mt-6">
          <ToolCategoryList categories={categories} tools={tools} />
        </div>
      </section>

      <AdPlaceholder label="Development ad placeholder before footer" />
    </Container>
  </main>
</BaseLayout>
