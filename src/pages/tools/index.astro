---
import AdPlaceholder from "../../components/common/AdPlaceholder.astro";
import Container from "../../components/common/Container.astro";
import SectionTitle from "../../components/common/SectionTitle.astro";
import ToolGrid from "../../components/tools/ToolGrid.astro";
import ToolSearch from "../../components/tools/ToolSearch.astro";
import { categories } from "../../data/categories";
import { activeTools, tools } from "../../data/tools";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="All Tools"
  description="Browse every active and planned ToolKit Hub utility from one searchable directory."
  path="/tools"
>
  <main class="flex-1">
    <Container class="py-10 md:py-14">
      <section class="max-w-4xl">
        <p class="text-sm font-semibold uppercase text-brand-teal">Tool directory</p>
        <h1 class="mt-3 text-3xl font-semibold text-ink md:text-4xl">All Tools</h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          Search active and planned browser-based tools from a single source of truth.
        </p>
      </section>

      <AdPlaceholder label="Development ad placeholder above all tools" />

      <section class="mt-8">
        <ToolSearch categories={categories}>
          <ToolGrid tools={tools} />
        </ToolSearch>
      </section>

      <AdPlaceholder label="Development ad placeholder between all tools list" />

      <section class="mt-12">
        <SectionTitle
          title="Available now"
          description="These tools are implemented and ready to run completely in the browser."
        />
        <div class="mt-6">
          <ToolGrid tools={activeTools} />
        </div>
      </section>

      <AdPlaceholder label="Development ad placeholder before footer" />
    </Container>
  </main>
</BaseLayout>
