---
import ToolPage from "../../components/pages/ToolPage.astro";
import { getActiveTools } from "../../data/tools";
import { defaultLocale } from "../../i18n/config";
import type { Tool } from "../../types/tool";

export function getStaticPaths() {
  return getActiveTools(defaultLocale).map((tool) => ({
    params: { slug: tool.slug },
    props: { tool }
  }));
}

const { tool } = Astro.props as { tool: Tool };
---

<ToolPage tool={tool} locale={defaultLocale} />
